<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Indexer/etc/indexer.xsd">
    <indexer id="myshopcarts_salesassistant_catalogue"
             view_id="myshopcarts_salesassistant_catalogue"
             class="Myshopcarts\SalesAssistant\Model\Indexer\Catalogue">
        <title translate="true">Sales Assistant Catalogue</title>
        <description translate="true">Embeds the catalogue into the Sales Assistant vector index</description>
