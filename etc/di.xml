<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The SSRF-guarded page fetcher is UrlFetcher; crawl discovery/ingest depend on the
         interface so the same guard applies to every fetched URL. -->
    <preference for="Myshopcarts\SalesAssistant\Model\Knowledge\PageFetcherInterface"
                type="Myshopcarts\SalesAssistant\Model\Knowledge\UrlFetcher"/>
    <preference for="Myshopcarts\SalesAssistant\Model\Ingest\KnowledgeIndexInterface"
                type="Myshopcarts\SalesAssistant\Model\Ingest\KnowledgeIndexer"/>
    <preference for="Myshopcarts\SalesAssistant\Model\Knowledge\DocumentRegistryInterface"
                type="Myshopcarts\SalesAssistant\Model\Knowledge\DocumentRepository"/>
    <!-- Keep the secret key out of shared/exported config.php — it lives only in
         the instance's env.php (Adobe security best practice: sensitive settings). -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="myshopcarts_salesassistant/api/secret_key" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <!-- Whitelist the merchant's OWN configured WebSocket host on connect-src at
         runtime (see Model/Csp/EndpointPolicyCollector) — NOT a static
         etc/csp_whitelist.xml, which would hardcode an env-specific backend host
         into a public extension and break any merchant on a different backend. -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="salesAssistantEndpoint" xsi:type="object" sortOrder="100">Myshopcarts\SalesAssistant\Model\Csp\EndpointPolicyCollector</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="salesassistant_reindex" xsi:type="object">Myshopcarts\SalesAssistant\Console\Command\Reindex</item>
            </argument>
        </arguments>
    </type>
    <!-- Knowledge sources the Knowledge indexer ingests. Pluggable: add uploaded-doc
         (S3, §12b) and URL/sitemap sources here later — no indexer change. -->
    <type name="Myshopcarts\SalesAssistant\Model\Indexer\Knowledge">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="cms_page" xsi:type="object">Myshopcarts\SalesAssistant\Model\Knowledge\Source\CmsPageSource</item>
                <item name="cms_block" xsi:type="object">Myshopcarts\SalesAssistant\Model\Knowledge\Source\CmsBlockSource</item>
                <item name="document" xsi:type="object">Myshopcarts\SalesAssistant\Model\Knowledge\Source\DocumentSource</item>
            </argument>
        </arguments>
    </type>
</config>
