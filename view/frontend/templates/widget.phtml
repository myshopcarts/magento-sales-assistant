<?php
/** @var \Myshopcarts\SalesAssistant\Block\Widget $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->isEnabled()) {
    return;
}
// Only a non-secret, same-origin token URL is passed to the browser. The logic
// lives in the module JS (loaded via text/x-magento-init — data, not inline
// script — so it stays CSP-clean); nothing secret or environment-specific here.
//
// The component is referenced by its FULL module id (Myshopcarts_SalesAssistant/js/widget),
// which RequireJS resolves natively — NOT via a requirejs-config `map` alias. That merged
// requirejs-config.min.js is regenerated by static-content:deploy, and if a deploy fails to
// merge our module's requirejs-config.js the alias would 404 the widget. The full id has no
// such dependency, so the widget is self-contained + install-robust.
$config = [
    'tokenUrl' => $block->getTokenUrl(),
    'searchUrl' => $block->getSearchUrl(),
    'knowledgeUrl' => $block->getKnowledgeUrl(),
    'greeting' => $block->getGreeting(),
    'assistantName' => $block->getAssistantName(),
    'businessContext' => $block->getBusinessContext(),
    'callToAction' => $block->getCallToAction(),
    'headerColor' => $block->getHeaderColor(),
    'attributeDescriptor' => $block->getAttributeDescriptor(),
];
?>
<div id="msc-sales-assistant" data-role="msc-sales-assistant"></div>
<script type="text/x-magento-init">
{
    "#msc-sales-assistant": {
        "Myshopcarts_SalesAssistant/js/widget": <?= /* @noEscape */ json_encode($config, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>
    }
}
</script>
